@using Clases.Pagos

@{
  
    Layout = "_Layout";
}

@if (Model != null)
{



  <div class="relative flex flex-col w-full h-full  text-white bg-transparent shadow-lg rounded-lg backdrop-blur-md border border-white/10">
    <table class="w-full text-left table-auto min-w-max">
      <thead>
      <tr class="bg-white/10 backdrop-blur-sm">
        <th class="p-4 border-b border-white/20">
          <p class="text-sm font-semibold uppercase tracking-wider text-gray-200">
            Nombre
          </p>
        </th>
        <th class="p-4 border-b border-white/20">
          <p class="text-sm font-semibold uppercase tracking-wider text-gray-200">
            Descripcion
          </p>
        </th>
        <th class="p-4 border-b border-white/20"></th>
      </tr>
      </thead>
  @if (Model.Count != 0)
      {
        <tbody>

        @foreach (TipoGasto tg in Model)
        {
@if (tg.Activo)
{
  <tr class="hover:bg-white/10 transition">
    <td class="p-4 border-b border-white/10">
      <p class="text-sm font-medium">@tg.Nombre</p>
    </td>
    <td class="p-4 border-b border-white/10">
      <p class="text-sm">@tg.Descripcion</p>
    </td>
    <td  class=" p-4 border-b border-white/10">
              
      @Html.ActionLink("Eliminar", "EliminarGasto", new{id= tg.Id})
             
    </td>
  </tr>
}
        }
        </tbody>
      }
  else
  {
    <p>No Hay tipo de gastos cargados.</p>
  }
    </table>
  </div>
}